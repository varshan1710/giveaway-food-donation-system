# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/giveaway?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin bootstrap (used only by seed script)
ADMIN_EMAIL=admin@giveaway.org
ADMIN_PASSWORD=ChangeMe123!

# --- Notifications (optional — leave blank to disable a channel) ---

# Email alerts to nearby NGOs when a new donation is posted.
# Works with a free Gmail account: enable 2-Step Verification, then
# generate an "App Password" at https://myaccount.google.com/apppasswords
# and use that here (NOT your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="GiveAway <your_email@gmail.com>"

# SMS alerts to nearby NGOs. Two options — set ONE of these:
#
# Option A (recommended, free): Textbee — https://textbee.dev
#   Free tier: 50 SMS/day, 300/month, no credit card. Requires a spare
#   Android phone running the free Textbee app as the SMS gateway.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Option B (paid): Twilio — used only if Textbee isn't configured above.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
