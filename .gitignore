# Dependencies
node_modules/
**/node_modules/

# Environment variables
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Production & Build outputs
dist/
build/
**/dist/
**/build/

# User Uploads (keep uploads folder via .gitkeep, ignore actual uploaded files)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE & Code Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Operating System files
.DS_Store
Thumbs.db
